# Replicate API Configuration
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database URL (for migrations and direct access)
DATABASE_URL=postgresql://postgres:password@localhost:5432/polaroid_album

# NextJS Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# File Storage (if using cloud storage instead of local)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=polaroid-family-album
S3_REGION=us-east-1

# Development/Production Environment
NODE_ENV=development

# Optional: For LoRA training on RunPod
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_ENDPOINT=your_runpod_endpoint